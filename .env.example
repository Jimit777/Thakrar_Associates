# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com -> API keys. Server-side only — never prefix with
# NEXT_PUBLIC_, or the key would be sent to every visitor's browser.
ANTHROPIC_API_KEY=

# Both of these are only needed for the nightly news digest. Leave them empty
# and the scheduled run turns itself off; the Refresh button still works.

# Supabase dashboard -> Project Settings -> API -> service_role key. This one
# bypasses every row-level security policy, so it must never be prefixed with
# NEXT_PUBLIC_ and must never be committed.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel sends it back as a bearer token so the cron
# route can tell a scheduled run from anyone who found the URL.
CRON_SECRET=
